# ============================================================
# CarePoint School Management System — Root Environment
# ============================================================
# This file documents monorepo-level environment variables
# used by Docker Compose for local development infrastructure.
#
# Application-specific variables:
#   Backend:  apps/api/.env.example
#   Frontend: apps/web/.env.example
#
# NEVER commit .env to version control.
# This file (.env.example) IS committed — it contains no
# real secrets, only variable names and safe defaults.
# ============================================================

# ------------------------------------------------------------
# Docker Compose — PostgreSQL (local development only)
#
# These values configure the PostgreSQL Docker container.
# The backend (apps/api/.env) must use matching credentials:
#   DB_URL=jdbc:postgresql://localhost:5432/${POSTGRES_DB}
#   DB_USERNAME=${POSTGRES_USER}
#   DB_PASSWORD=${POSTGRES_PASSWORD}
# ------------------------------------------------------------
POSTGRES_DB=put_your_postgres_database_name_here
POSTGRES_USER=put_your_postgres_name_here
POSTGRES_PASSWORD=put_your_postgres_password_here

# ------------------------------------------------------------
# Docker Compose — Redis (uncomment in docker-compose.yml when needed)
# ------------------------------------------------------------
# REDIS_PASSWORD=

