# ============================================================
# Karatu SIS — Frontend Environment
# ============================================================
# Copy this file to .env.local and fill in the values.
#
# NEVER commit .env.local to version control.
# This file (.env.example) IS committed — it contains no
# real secrets, only variable names and safe defaults.
#
# NEXT_PUBLIC_ variables are exposed to the browser.
# Non-prefixed variables are server-only (Next.js server components).
#
# The frontend must NEVER hold:
#   - Database credentials
#   - JWT secrets
#   - Paystack secret key
#   - Any backend service secret
# ============================================================

# ------------------------------------------------------------
# Product identity. Leave root domain blank until one is selected.
# ------------------------------------------------------------
NEXT_PUBLIC_KARATU_PRODUCT_NAME=Karatu SIS
NEXT_PUBLIC_KARATU_PRODUCT_SLUG=karatu
NEXT_PUBLIC_KARATU_ROOT_DOMAIN=

# ------------------------------------------------------------
# API mode and tenant for the legacy admissions route
# ------------------------------------------------------------
NEXT_PUBLIC_KARATU_API_MODE=mock
NEXT_PUBLIC_KARATU_DEFAULT_SCHOOL_SLUG=carepoint

# ------------------------------------------------------------
# Backend API
# The URL of the Spring Boot REST API.
# Used by both browser (NEXT_PUBLIC_) and server-side fetch.
# ------------------------------------------------------------
NEXT_PUBLIC_KARATU_API_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------
# Paystack
# Only the PUBLIC key is safe to expose to the browser.
# Never use PAYSTACK_SECRET_KEY in the frontend.
# https://dashboard.paystack.com/#/settings/developers
# ------------------------------------------------------------
NEXT_PUBLIC_KARATU_PAYSTACK_PUBLIC_KEY=

# ------------------------------------------------------------
# Sentry Error Monitoring (client-side)
# https://sentry.io
# ------------------------------------------------------------
NEXT_PUBLIC_KARATU_SENTRY_DSN=

